# Quay stack environment — copy to .env and fill in values
# Generated by: DOMAIN=registry.example.com sh install.sh
# The installer generates this file automatically; edit only to override defaults.
#
# Generate a random password:
#   head -c 64 /dev/urandom | tr -dc 'A-Za-z0-9' | head -c 24
# Generate a 48-char secret key:
#   head -c 96 /dev/urandom | tr -dc 'A-Za-z0-9' | head -c 48

TZ=America/New_York
BASE_DOMAIN_NAME=registry.example.com
BASE_HOST_NAME=registry.example.com
HOST_IP_4=172.17.0.1
QUAY_BIND_ADDR=172.17.0.1
QUAY_PORT=62080
SMTP_HOST=172.17.0.1
SMTP_PORT=25
SMTP_ENABLED=false
DB_USER_NAME=quay
DB_CREATE_DATABASE_NAME=quay
DB_USER_PASS=
CLAIR_DB_USER_NAME=clair
CLAIR_DB_USER_PASS=
QUAY_SECRET_KEY=
APP_ADMIN_USER=administrator
APP_ADMIN_PASS=
COSIGN_KEY_FILE=/opt/quay/volumes/config/credentials/cosign.key
COSIGN_PUB_FILE=/opt/quay/volumes/config/credentials/cosign.pub
