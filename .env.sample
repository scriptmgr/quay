# Quay stack environment — generated by: DOMAIN=registry.example.com sh install.sh
# The installer writes this file automatically on every run.
# Only the variables below marked "override" need to be set manually.
#
# Generate a random password:  head -c 64 /dev/urandom | tr -dc 'A-Za-z0-9' | head -c 24
# Generate a 48-char key:      head -c 96 /dev/urandom | tr -dc 'A-Za-z0-9' | head -c 48

TZ=America/New_York
BASE_DOMAIN_NAME=registry.example.com
BASE_HOST_NAME=registry.example.com
HOST_IP_4=172.17.0.1
QUAY_BIND_ADDR=172.17.0.1
QUAY_PORT=62080
SMTP_HOST=172.17.0.1
SMTP_PORT=25
APP_ADMIN_USER=administrator
APP_ADMIN_PASS=
REGISTRY_TITLE=Quay
REGISTRY_TITLE_SHORT=Quay
QUAY_IMAGE=quay.io/projectquay/quay:latest
CLAIR_IMAGE=quay.io/projectquay/clair:latest
QUAY_SECRET_KEY=
DB_USER_NAME=
DB_CREATE_DATABASE_NAME=
DB_USER_PASS=
CLAIR_DB_USER_NAME=
CLAIR_DB_USER_PASS=
COSIGN_KEY_FILE=/opt/quay/volumes/config/credentials/cosign.key
COSIGN_PUB_FILE=/opt/quay/volumes/config/credentials/cosign.pub
